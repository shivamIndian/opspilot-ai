# OpsPilot AI Microservice Environment Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL 16 + asyncpg - Schema: ai)
AI_DATABASE_URL=postgresql+asyncpg://opspilot_ai:change_this_ai_password@localhost:5432/opspilot_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30

# Redis Configuration (Redis 7 - DB 1)
REDIS_URL=redis://:change_this_redis_password@localhost:6379/1

# Internal Service Authentication (Shared secret between Node.js and Python)
AI_SERVICE_INTERNAL_TOKEN=opspilot_internal_service_token_dev_secret_32char!

# Document Processing & Extraction Limits
MAX_DOCUMENT_PAGES=500
MAX_EXTRACTED_CHARS=5000000
MAX_CHUNKS_PER_DOCUMENT=10000

# Chunking Configuration
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
PIPELINE_VERSION=document-pipeline-v1

# Embedding Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=replace_with_actual_key
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_RETRIES=3
EMBEDDING_REQUEST_TIMEOUT=60.0

# LLM Configuration (Module 10)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_MAX_OUTPUT_TOKENS=1500
LLM_REQUEST_TIMEOUT=60.0
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_MAX_CONTEXT_TOKENS=8000
LLM_MAX_QUERY_LENGTH=5000
LLM_PROMPT_VERSION=rag_assistant_v1
