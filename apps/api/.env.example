# OpsPilot Core API Environment Variables
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Database Configuration (PostgreSQL 16 - Schema: app)
DATABASE_URL=postgresql://opspilot_api:change_this_api_password@localhost:5432/opspilot_db?schema=app
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Redis Configuration (Redis 7 - DB 0)
REDIS_URL=redis://:change_this_redis_password@localhost:6379/0
REDIS_CONNECT_TIMEOUT_MS=5000

# JWT & Authentication Configuration
JWT_ACCESS_SECRET=opspilot_dev_jwt_access_secret_key_minimum_32_characters_long!
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=opspilot-api
JWT_AUDIENCE=opspilot-client

# Refresh Tokens & Cookie Security
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=opspilot_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_DOMAIN=

# CSRF Protection
CSRF_COOKIE_NAME=opspilot_csrf_token
CSRF_HEADER_NAME=x-csrf-token

# Token TTL Windows
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# Document Storage Configuration
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_ROOT=.data/opspilot-uploads
MAX_DOCUMENT_SIZE_MB=25

# Internal AI Service & Document Processing Queue
AI_SERVICE_INTERNAL_TOKEN=opspilot_internal_service_token_dev_secret_32char!
DOCUMENT_PROCESSING_QUEUE=opspilot-document-processing
DOCUMENT_PROCESSING_CONCURRENCY=2
DOCUMENT_PROCESSING_ATTEMPTS=3

# Document Embedding Queue & Provider Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DOCUMENT_EMBEDDING_QUEUE=opspilot-document-embeddings
DOCUMENT_EMBEDDING_CONCURRENCY=3
DOCUMENT_EMBEDDING_ATTEMPTS=3

MAIL_PROVIDER=development
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="OpsPilot AI <noreply@opspilot.internal>"
