{
  "name": "@opspilot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:dev": "tsx watch src/workers/document-processing.worker.ts",
    "worker:start": "node dist/workers/document-processing.worker.js",
    "worker:embedding:dev": "tsx watch src/workers/document-embedding.worker.ts",
    "worker:embedding:start": "node dist/workers/document-embedding.worker.js",
    "worker:approval:dev": "tsx watch src/workers/agent-approval-outbox.worker.ts",
    "worker:approval:start": "node dist/workers/agent-approval-outbox.worker.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "admin:promote": "tsx src/scripts/bootstrapAdmin.ts",
    "db:migrate": "node-pg-migrate up --envPath .env --migrations-dir src/database/migrations --schema app --migrations-schema app",
    "db:rollback": "node-pg-migrate down --envPath .env --migrations-dir src/database/migrations --schema app --migrations-schema app",
    "db:status": "node-pg-migrate up --dry-run --envPath .env --migrations-dir src/database/migrations --schema app --migrations-schema app",
    "db:create": "node-pg-migrate create --envPath .env --migrations-dir src/database/migrations --migration-file-language cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@node-rs/argon2": "^2.2.2",
    "@types/multer": "^2.3.0",
    "bullmq": "^6.5.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "rate-limit-redis": "^6.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.16.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
