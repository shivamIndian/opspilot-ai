# ==============================================================================
# OpsPilot AI - Monorepo Master Environment Configuration (.env.example)
# Copy this file to .env files or inject via secure secret managers.
# DO NOT COMMIT PRODUCTION SECRETS TO SOURCE CONTROL.
# ==============================================================================

# --- Frontend (@opspilot/web) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1

# --- Backend API (@opspilot/api) ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
AI_SERVICE_URL=http://localhost:8000

# Authentication & Security
JWT_ACCESS_SECRET=opspilot_dev_jwt_access_secret_key_minimum_32_characters_long!
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=opspilot_refresh_token
REFRESH_COOKIE_SECURE=false
CSRF_COOKIE_NAME=opspilot_csrf_token
AI_SERVICE_INTERNAL_TOKEN=opspilot_internal_service_token_dev_secret_32char!

# Document Storage (local or s3)
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_ROOT=.data/opspilot-uploads
MAX_DOCUMENT_SIZE_MB=25
AWS_REGION=us-east-1
AWS_S3_DOCUMENT_BUCKET=opspilot-documents-private

# Backend Database (PostgreSQL 16 - Schema: app)
DATABASE_URL=postgresql://opspilot_api:change_this_api_password@localhost:5432/opspilot_db?schema=app
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Backend Redis (Redis 7 - DB 0)
REDIS_URL=redis://:change_this_redis_password@localhost:6379/0
REDIS_CONNECT_TIMEOUT_MS=5000

# --- AI Microservice (opspilot-ai-service) ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
CORE_API_URL=http://localhost:4000

# LLM & Embeddings Provider (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# AI Database (PostgreSQL 16 + asyncpg - Schema: ai)
AI_DATABASE_URL=postgresql+asyncpg://opspilot_ai:change_this_ai_password@localhost:5432/opspilot_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30

# AI Redis (Redis 7 - DB 1)
REDIS_URL=redis://:change_this_redis_password@localhost:6379/1

# --- Local Docker Infrastructure ---
POSTGRES_DB=opspilot_db
POSTGRES_ADMIN_USER=opspilot_admin
POSTGRES_ADMIN_PASSWORD=change_this_local_password
API_DB_USER=opspilot_api
API_DB_PASSWORD=change_this_api_password
AI_DB_USER=opspilot_ai
AI_DB_PASSWORD=change_this_ai_password
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password
